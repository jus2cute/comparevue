---
export interface Props {
  headings: Array<{ text: string; slug: string; depth: number }>;
}
const toc = Astro.props.headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
{toc.length > 0 && (
  <nav class="my-8 rounded-xl border border-gray-200 bg-gray-50 p-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500">On this page</h2>
    <ul class="mt-3 space-y-1">
      {toc.map(h => (
        <li style={'padding-left: ' + ((h.depth - 2) * 16) + 'px'}>
          <a href={'#' + h.slug} class="text-sm text-gray-600 hover:text-brand-600">{h.text}</a>
        </li>
      ))}
    </ul>
  </nav>
)}
