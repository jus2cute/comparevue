---
export interface Props {
  headings: Array<{ text: string; slug: string; depth: number }>;
}
const toc = Astro.props.headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
{toc.length > 0 && (
  <nav>
    <ul class="space-y-0.5">
      {toc.map((h, i) => (
        <li>
          <a
            href={'#' + h.slug}
            class={`block py-1.5 text-sm transition-colors duration-150 leading-snug ${h.depth === 3 ? 'pl-4' : ''} text-gray-500 hover:text-brand-600 border-l-2 ${h.depth === 3 ? 'ml-2 border-transparent' : 'border-transparent'} ${i === 0 ? 'text-brand-600 font-semibold border-brand-500' : ''}`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
