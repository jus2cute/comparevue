---
// RelatedContent.astro — Finds and displays related comparisons & articles
// Groups by same-category, then by recency. Boosts internal linking and time-on-site.
import { getCollection } from 'astro:content';

export interface Props {
  currentSlug: string;
  category: string;
  type: 'comparisons' | 'articles';
  excludeSlugs?: string[];
  limit?: number;
}

const {
  currentSlug,
  category,
  type,
  excludeSlugs = [],
  limit = 3,
} = Astro.props;

const all = type === 'comparisons'
  ? await getCollection('comparisons')
  : await getCollection('articles');

const excluded = new Set([currentSlug, ...excludeSlugs]);

// Prefer same category, then fall back to any
const sameCategory = all
  .filter(c => c.data.category === category && !excluded.has(c.id))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, limit);

const others = all
  .filter(c => c.data.category !== category && !excluded.has(c.id))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, limit - sameCategory.length);

const related = [...sameCategory, ...others].slice(0, limit);

if (related.length === 0) return null;

const prefix = type === 'comparisons' ? '/comparisons/' : '/articles/';
---

<div class="mt-12 border-t border-gray-200 pt-10">
  <h2 class="text-xl font-bold text-gray-900 mb-5">
    {type === 'comparisons' ? 'Related Comparisons' : 'Related Articles'}
  </h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {related.map(item => (
      <a
        href={prefix + item.id}
        class="group rounded-xl border border-gray-200 bg-white p-5 transition-all hover:border-brand-200 hover:shadow-md no-underline"
      >
        <span class="inline-block rounded-full bg-brand-100 text-brand-700 text-xs font-medium px-2.5 py-0.5 mb-2">
          {item.data.category}
        </span>
        <h3 class="text-sm font-semibold text-gray-900 group-hover:text-brand-600 line-clamp-2 leading-snug">
          {item.data.title}
        </h3>
        <p class="mt-1 text-xs text-gray-500 line-clamp-1">{item.data.description}</p>
        <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-brand-600 group-hover:gap-1.5 transition-all">
          Read {type === 'comparisons' ? 'comparison' : 'article'}
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
    ))}
  </div>
</div>
