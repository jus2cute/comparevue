---
export interface Props {
  title: string;
  description: string;
  slug: string;
  date: Date;
  updatedDate?: Date;
  category?: string;
  readTime?: string;
}

const { title, description, slug, date, updatedDate, category, readTime } = Astro.props;
const href = slug.startsWith('/') ? slug : '/articles/' + slug;
const showUpdated = updatedDate && updatedDate > date;
const displayDate = showUpdated ? updatedDate : date;
---

<a href={href} class="group block rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:border-brand-200 hover:shadow-lg hover:shadow-brand-50/50 hover:-translate-y-0.5 no-underline">
  {category && (
    <span class="inline-flex rounded-full bg-brand-100/80 px-3 py-1 text-xs font-semibold text-brand-700 uppercase tracking-wide mb-4">{category}</span>
  )}
  <h3 class="text-lg font-bold text-gray-900 group-hover:text-brand-600 transition-colors leading-snug line-clamp-2 text-balance">{title}</h3>
  <p class="mt-2.5 line-clamp-2 text-sm text-gray-500 leading-relaxed">{description}</p>
  <div class="mt-4 flex items-center gap-2 text-xs text-gray-400 flex-wrap">
    {showUpdated ? (
      <>
        <span class="inline-flex items-center gap-1 text-brand-600 font-medium">
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
          Updated {displayDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
        </span>
      </>
    ) : (
      <time datetime={date.toISOString().split('T')[0]}>
        {date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
      </time>
    )}
    {readTime && <span class="text-gray-300">·</span>}
    {readTime && <span>{readTime}</span>}
  </div>
</a>
