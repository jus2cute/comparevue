---
const nav = [
  { label: 'Comparisons', href: '/comparisons' },
  { label: 'Articles', href: '/articles' },
  { label: 'About', href: '/about' },
];
---
<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 text-xl font-bold text-gray-900 no-underline">
      <span class="text-brand-600">⚡</span>
      <span>CompareVue</span>
    </a>
    <nav class="hidden items-center gap-8 md:flex">
      {nav.map(item => (
        <a href={item.href} class="text-sm font-medium text-gray-600 transition hover:text-brand-600">
          {item.label}
        </a>
      ))}
    </nav>
    <button class="md:hidden" aria-label="Menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
    </button>
  </div>
</header>
