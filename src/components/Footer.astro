---
const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-gray-100 bg-gray-50/80">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div>
        <a href="/" class="flex items-center gap-2 text-lg font-bold text-gray-900 no-underline mb-3">
          <span class="text-brand-600">⚡</span>
          <span>CompareVue</span>
        </a>
        <p class="text-sm text-gray-500 leading-relaxed max-w-xs">
          Honest, data-driven SaaS comparisons. We test every tool hands-on — no sponsored reviews, no AI-generated fluff.
        </p>
      </div>

      <!-- Content -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">Content</h3>
        <ul class="space-y-2.5">
          <li><a href="/comparisons" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Comparisons</a></li>
          <li><a href="/articles" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Articles</a></li>
          <li><a href="/search" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Search</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">Company</h3>
        <ul class="space-y-2.5">
          <li><a href="/about" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">About</a></li>
          <li><a href="/methodology" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Methodology</a></li>
          <li><a href="/editorial-policy" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Editorial Policy</a></li>
          <li><a href="/contact" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Contact</a></li>
          <li><a href="mailto:hello@comparevue.com" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">hello@comparevue.com</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">Legal</h3>
        <ul class="space-y-2.5">
          <li><a href="/privacy" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-gray-600 hover:text-brand-600 transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-gray-400">
        &copy; {year} CompareVue. All rights reserved.
      </p>
      <p class="text-xs text-gray-400">
        We may earn a commission from some links — at no extra cost to you.
      </p>
    </div>
  </div>
</footer>
