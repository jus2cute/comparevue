---
const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-gray-100 bg-gray-50 py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold text-gray-900">CompareVue</h3>
        <p class="mt-2 text-sm text-gray-600">Honest, data-driven software comparisons to help you pick the right tools.</p>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Content</h3>
        <ul class="mt-2 space-y-2">
          <li><a href="/comparisons" class="text-sm text-gray-600 hover:text-brand-600">Comparisons</a></li>
          <li><a href="/articles" class="text-sm text-gray-600 hover:text-brand-600">Articles</a></li>
          <li><a href="/about" class="text-sm text-gray-600 hover:text-brand-600">About</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-gray-900">Legal</h3>
        <ul class="mt-2 space-y-2">
          <li><a href="/privacy" class="text-sm text-gray-600 hover:text-brand-600">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-gray-600 hover:text-brand-600">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-8 border-t border-gray-200 pt-8 text-center">
      <p class="text-xs text-gray-500">&copy; {year} CompareVue. Some links may be affiliate links.</p>
    </div>
  </div>
</footer>
