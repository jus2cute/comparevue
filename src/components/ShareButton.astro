---
// ShareButton.astro — Copy-to-clipboard share button + tooltip
// Lightweight, no external dependencies. Puts the page URL on clipboard.
---

<button
  id="share-btn"
  class="inline-flex items-center gap-2 rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 transition-all hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50"
  aria-label="Copy link to clipboard"
  title="Copy link"
>
  <svg id="share-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
  </svg>
  <span id="share-text">Share</span>
</button>

<script>
  const btn = document.getElementById('share-btn');
  if (btn) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const text = document.getElementById('share-text');
        const icon = document.getElementById('share-icon');
        if (text) text.textContent = 'Copied!';
        if (icon) {
          icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>';
        }
        btn.classList.add('text-green-600', 'border-green-300', 'bg-green-50');
        setTimeout(() => {
          if (text) text.textContent = 'Share';
          if (icon) {
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>';
          }
          btn.classList.remove('text-green-600', 'border-green-300', 'bg-green-50');
        }, 2000);
      } catch {
        // Fallback for older browsers
        const text = document.getElementById('share-text');
        if (text) text.textContent = window.location.href;
      }
    });
  }
</script>
