---
// AuthorBio.astro — Author/editor card with photo placeholder, credentials, review date
// Critical trust signal for E-E-A-T SEO (expertise, authoritativeness, trustworthiness)
export interface Props {
  name?: string;
  role?: string;
  bio?: string;
  reviewedDate?: Date;
}

const {
  name = 'CompareVue Editorial Team',
  role = 'Software Review Specialist',
  bio = 'Our editorial team has tested 50+ SaaS tools across CRM, project management, and productivity categories. Every review is based on hands-on testing — not marketing demos.',
  reviewedDate,
} = Astro.props;

const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2);
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: role,
  description: bio,
};
---

<div class="mt-10 rounded-2xl border border-gray-200 bg-white p-6 sm:p-8">
  <div class="flex flex-col sm:flex-row items-start gap-4">
    <div class="shrink-0 w-14 h-14 rounded-full bg-gradient-to-br from-brand-600 to-brand-800 flex items-center justify-center text-white font-extrabold text-lg ring-4 ring-brand-50">
      {initials}
    </div>
    <div>
      <div class="flex items-center gap-2 mb-1 flex-wrap">
        <h3 class="font-extrabold text-gray-900">{name}</h3>
        <span class="text-xs text-gray-400">·</span>
        <span class="text-sm text-gray-500">{role}</span>
      </div>
      <p class="text-sm text-gray-600 leading-relaxed">{bio}</p>
      <div class="mt-3 flex flex-wrap items-center gap-4 text-xs text-gray-400">
        {reviewedDate && (
          <span class="inline-flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Reviewed {reviewedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </span>
        )}
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
          </svg>
          Fact-checked
        </span>
        <span class="inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          No AI-only content
        </span>
      </div>
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)}></script>
</div>
