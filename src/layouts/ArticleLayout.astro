---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButton from '../components/ShareButton.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  headings: Array<{ text: string; slug: string; depth: number }>;
  slug: string;
  takeaways?: string[];
  heroImage?: string;
}

const {
  title, description, image, pubDate, updatedDate,
  author = 'CompareVue', category, headings, slug,
  takeaways, heroImage,
} = Astro.props;

const readTime = Math.max(3, Math.ceil((description.length + 3000) / 1500));
const readTimeStr = readTime + ' min read';
const displayDate = updatedDate && updatedDate > pubDate ? updatedDate : pubDate;
const showUpdate = updatedDate && updatedDate > pubDate;
const heroUrl = heroImage || image;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://comparevue.com/' },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://comparevue.com/articles/' },
    ...(category ? [{ '@type': 'ListItem', position: 3, name: category, item: `https://comparevue.com/articles/` }] : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: title },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image || 'https://comparevue.com/images/og-default.svg',
  datePublished: pubDate.toISOString(),
  dateModified: displayDate.toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: 'CompareVue' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://comparevue.com/articles/' + slug + '/' },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  articlePublished={pubDate}
  articleModified={updatedDate}
  schema={articleSchema}
>
  <ReadingProgress />

  <article class="relative">
    <!-- Hero Section -->
    <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/70 via-white to-white">
      <!-- Subtle grid pattern background -->
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 32px 32px;"></div>

      <div class="relative mx-auto max-w-4xl px-4 pt-12 sm:pt-16 lg:pt-20 sm:px-6 lg:px-8">
        <!-- Breadcrumbs -->
        <nav class="mb-6 text-sm" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap text-gray-400">
            <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/articles" class="hover:text-brand-600 transition-colors">Articles</a></li>
            {category && <><li aria-hidden="true">/</li><li><a href="/articles" class="hover:text-brand-600 transition-colors">{category}</a></li></>}
          </ol>
        </nav>

        <!-- Category + meta -->
        <div class="flex flex-wrap items-center gap-3 mb-5">
          {category && <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-3.5 py-1 text-xs font-semibold text-brand-700 uppercase tracking-wide">{category}</span>}
          <span class="text-sm text-gray-400">·</span>
          <span class="text-sm text-gray-500">{readTimeStr}</span>
          {showUpdate && <span class="inline-flex items-center gap-1 text-sm text-brand-600 font-medium"><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>}
        </div>

        <!-- Title -->
        <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance leading-tight tracking-tight">
          {title}
        </h1>

        <!-- Description -->
        <p class="mt-5 text-lg sm:text-xl text-gray-500 leading-relaxed max-w-3xl text-pretty">
          {description}
        </p>

        <!-- Author + date row -->
        <div class="mt-8 flex flex-wrap items-center gap-4 pb-8 border-b border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-bold ring-2 ring-white shadow-sm">
              {author.split(' ').map(n => n[0]).join('').slice(0, 2)}
            </div>
            <div>
              <p class="text-sm font-semibold text-gray-900">{author}</p>
              <div class="flex items-center gap-2 text-xs text-gray-400">
                <time datetime={displayDate.toISOString().split('T')[0]}>
                  {displayDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                <span aria-hidden="true">·</span>
                <span>Fact-checked</span>
              </div>
            </div>
          </div>
          <div class="ml-auto">
            <ShareButton />
          </div>
        </div>
      </div>
    </header>

    <!-- Key Takeaways -->
    {takeaways && takeaways.length > 0 && (
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-8">
        <div class="rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/60 p-6 sm:p-8">
          <div class="flex items-center gap-2 mb-4">
            <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <h2 class="text-lg font-bold text-amber-900">Key Takeaways</h2>
          </div>
          <ul class="space-y-2.5">
            {takeaways.map(t => (
              <li class="flex gap-3 text-sm text-amber-900/80 leading-relaxed">
                <svg class="w-4 h-4 text-amber-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    )}

    <!-- Layout: Sidebar + Content -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-10">
      <div class="flex gap-12 lg:gap-16">
        <!-- Sidebar: Table of Contents (desktop) -->
        <aside class="hidden w-56 shrink-0 lg:block">
          <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">On This Page</p>
            <TableOfContents headings={headings} />
          </div>
        </aside>

        <!-- Main content -->
        <div class="min-w-0 flex-1">
          <!-- Prose article body -->
          <div class="prose prose-lg prose-gray max-w-none
            prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-gray-900 prose-headings:scroll-mt-28
            prose-h2:text-2xl prose-h2:mt-14 prose-h2:mb-5
            prose-h3:text-xl prose-h3:mt-10 prose-h3:mb-4
            prose-p:leading-relaxed prose-p:text-gray-700
            prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
            prose-strong:text-gray-900 prose-strong:font-semibold
            prose-blockquote:border-l-4 prose-blockquote:border-brand-400 prose-blockquote:bg-brand-50/50 prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-gray-700
            prose-li:marker:text-gray-400
            prose-img:rounded-xl prose-img:shadow-md
            prose-hr:border-gray-200
            prose-code:bg-brand-50 prose-code:text-brand-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
            [&_table]:w-full [&_table]:text-sm [&_table]:border-collapse [&_table]:rounded-xl [&_table]:overflow-hidden
            [&_thead]:bg-gray-50 [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:text-xs [&_th]:font-semibold [&_th]:text-gray-500 [&_th]:uppercase [&_th]:tracking-wider
            [&_td]:px-4 [&_td]:py-3 [&_td]:border-t [&_td]:border-gray-100 [&_td]:text-gray-700
            [&_tr:hover_td]:bg-brand-50/30
            [&_table]:border [&_table]:border-gray-200
          ">
            <slot />
          </div>

          <!-- Mobile ToC -->
          <details class="mt-8 rounded-xl border border-gray-200 bg-gray-50 lg:hidden group">
            <summary class="cursor-pointer px-6 py-4 text-sm font-semibold uppercase tracking-wider text-gray-500 select-none group-open:border-b group-open:border-gray-200">
              On This Page
            </summary>
            <div class="px-6 pb-4 pt-2"><TableOfContents headings={headings} /></div>
          </details>

          <!-- Visual Divider -->
          <div class="mt-12 flex items-center gap-4" aria-hidden="true">
            <div class="h-px flex-1 bg-gray-200"></div>
            <div class="flex gap-1.5">
              <div class="w-1.5 h-1.5 rounded-full bg-brand-400"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-brand-300"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-brand-200"></div>
            </div>
            <div class="h-px flex-1 bg-gray-200"></div>
          </div>

          <!-- CTA Section -->
          <div class="mt-10 rounded-2xl bg-gradient-to-br from-brand-600 via-brand-700 to-brand-800 p-8 sm:p-10 text-center relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 24px 24px;"></div>
            <div class="relative">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3 py-1 text-xs font-semibold text-white/90 mb-5 uppercase tracking-wider">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Next Step
              </span>
              <h3 class="text-2xl font-bold text-white mb-3">Ready to find the right tool?</h3>
              <p class="text-brand-200/90 leading-relaxed max-w-md mx-auto">
                We've tested {category ? category.toLowerCase() + ' tools' : 'dozens of tools'} hands-on. See our head-to-head comparisons to find the best fit for your team.
              </p>
              <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
                <a href="/comparisons" class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3 text-sm font-bold text-brand-700 hover:bg-brand-50 transition shadow-lg shadow-black/10 hover:shadow-xl hover:shadow-black/15">
                  Browse Comparisons
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </a>
              </div>
              <p class="mt-4 text-xs text-brand-300/80">We may earn a commission if you sign up through our comparison pages, at no extra cost to you.</p>
            </div>
          </div>

          <!-- Author Bio -->
          <AuthorBio reviewedDate={displayDate} />

          <!-- Share -->
          <div class="mt-8 flex items-center justify-center gap-2">
            <span class="text-xs text-gray-400 mr-2">Share this article:</span>
            <ShareButton />
          </div>
        </div>
      </div>
    </div>

    <!-- Related Content -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <RelatedContent currentSlug={slug} category={category || ''} type="articles" />
    </div>

    <!-- Breadcrumb schema -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </article>

  <!-- Table of Contents scroll spy -->
  <script>
    function initTocSpy() {
      const headings = document.querySelectorAll('h2[id], h3[id]');
      const tocNav = document.querySelector('aside nav');
      if (!tocNav || headings.length === 0) return;
      const tocLinks = tocNav.querySelectorAll('a[href^="#"]');
      if (tocLinks.length === 0) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => {
              link.classList.remove('text-brand-600', 'font-semibold', 'border-brand-500');
              link.classList.add('text-gray-500', 'border-transparent');
              if (link.getAttribute('href') === '#' + entry.target.id) {
                link.classList.add('text-brand-600', 'font-semibold', 'border-brand-500');
                link.classList.remove('text-gray-500', 'border-transparent');
              }
            });
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

      headings.forEach(h => observer.observe(h));
    }

    initTocSpy();
  </script>
</BaseLayout>
