---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  headings: Array<{ text: string; slug: string; depth: number }>;
}

const {
  title, description, image, pubDate, updatedDate,
  author = 'CompareVue', category, headings,
} = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image || '/images/og-default.png',
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate || pubDate).toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: 'CompareVue' },
};

const readTime = Math.ceil((description.length + 1000) / 1500) + ' min read';
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  articlePublished={pubDate}
  articleModified={updatedDate}
  schema={articleSchema}
>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-8 text-sm text-gray-500" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-brand-600">Home</a></li>
        <li>/</li>
        {category && <><li><a href="/articles" class="hover:text-brand-600">{category}</a></li><li>/</li></>}
        <li class="text-gray-900">{title}</li>
      </ol>
    </nav>

    <header class="mb-8">
      {category && <span class="badge mb-4">{category}</span>}
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-gray-600">{description}</p>
      <div class="mt-6 flex items-center gap-4 text-sm text-gray-500">
        <time datetime={pubDate.toISOString().split('T')[0]}>
          {pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <span>·</span>
        <span>{readTime}</span>
        {updatedDate && updatedDate > pubDate && <>
          <span>·</span>
          <span>Updated <time datetime={updatedDate.toISOString().split('T')[0]}>
            {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time></span>
        </>}
      </div>
    </header>

    <div class="flex gap-12">
      <aside class="hidden w-64 shrink-0 lg:block">
        <div class="sticky top-24"><TableOfContents headings={headings} /></div>
      </aside>
      <div class="min-w-0 flex-1">
        <div class="prose prose-lg prose-gray max-w-none"><slot /></div>
      </div>
    </div>

    <details class="mt-8 rounded-xl border border-gray-200 bg-gray-50 lg:hidden">
      <summary class="cursor-pointer px-6 py-4 text-sm font-semibold uppercase tracking-wider text-gray-500">
        On this page
      </summary>
      <div class="px-6 pb-4"><TableOfContents headings={headings} /></div>
    </details>
  </article>
</BaseLayout>
