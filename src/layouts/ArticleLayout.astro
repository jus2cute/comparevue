---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import AuthorBio from '../components/AuthorBio.astro';
import ShareButton from '../components/ShareButton.astro';
import RelatedContent from '../components/RelatedContent.astro';
import ReadingProgress from '../components/ReadingProgress.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
  headings: Array<{ text: string; slug: string; depth: number }>;
  slug: string;
}

const {
  title, description, image, pubDate, updatedDate,
  author = 'CompareVue', category, headings, slug,
} = Astro.props;

const readTime = Math.ceil((description.length + 1000) / 1500);
const readTimeStr = readTime < 1 ? '1 min read' : readTime + ' min read';
const displayDate = updatedDate && updatedDate > pubDate ? updatedDate : pubDate;

// BreadcrumbList structured data
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://comparevue.com/' },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: 'https://comparevue.com/articles/' },
    ...(category ? [{ '@type': 'ListItem', position: 3, name: category, item: `https://comparevue.com/articles/` }] : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: title },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: image || 'https://comparevue.com/images/og-default.svg',
  datePublished: pubDate.toISOString(),
  dateModified: displayDate.toISOString(),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: 'CompareVue' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': 'https://comparevue.com/articles/' + slug + '/' },
};
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  articlePublished={pubDate}
  articleModified={updatedDate}
  schema={articleSchema}
>
  <ReadingProgress />

  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Breadcrumbs -->
    <nav class="mb-8 text-sm text-gray-400" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
        <li aria-hidden="true">/</li>
        {category && <><li><a href="/articles" class="hover:text-brand-600 transition-colors">{category}</a></li><li aria-hidden="true">/</li></>}
        <li class="text-gray-500 truncate max-w-[240px]" aria-current="page">{title}</li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="mb-10">
      {category && <span class="badge mb-4">{category}</span>}
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance">{title}</h1>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-gray-500">
        <time datetime={displayDate.toISOString().split('T')[0]}>
          {displayDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
        </time>
        <span aria-hidden="true">·</span>
        <span>{readTimeStr}</span>
        {updatedDate && updatedDate > pubDate && (
          <>
            <span aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1">
              <svg class="w-3.5 h-3.5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
              </svg>
              Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
          </>
        )}
        <span aria-hidden="true">·</span>
        <ShareButton />
      </div>
    </header>

    <!-- Layout: Sidebar + Content -->
    <div class="flex gap-12">
      <!-- Sidebar: Table of Contents -->
      <aside class="hidden w-64 shrink-0 lg:block">
        <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-4">On This Page</h4>
          <TableOfContents headings={headings} />
        </div>
      </aside>

      <!-- Main content -->
      <div class="min-w-0 flex-1">
        <div class="prose prose-lg prose-gray max-w-none">
          <slot />
        </div>

        <!-- Mobile ToC -->
        <details class="mt-8 rounded-xl border border-gray-200 bg-gray-50 lg:hidden">
          <summary class="cursor-pointer px-6 py-4 text-sm font-semibold uppercase tracking-wider text-gray-500 select-none">
            On This Page
          </summary>
          <div class="px-6 pb-4"><TableOfContents headings={headings} /></div>
        </details>

        <!-- Author Bio -->
        <AuthorBio reviewedDate={displayDate} />

        <!-- Share -->
        <div class="mt-6 flex items-center justify-center gap-3">
          <ShareButton />
        </div>
      </div>
    </div>

    <!-- Related Content -->
    <RelatedContent currentSlug={slug} category={category || ''} type="articles" />

    <!-- Breadcrumb schema -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </article>
</BaseLayout>
