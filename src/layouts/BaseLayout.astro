---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  articlePublished?: Date;
  articleModified?: Date;
  schema?: Record<string, any>;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Impact site verification — must be first in <head> -->
    <meta name="impact-site-verification" value="5f9d5c67-21fd-436e-ab92-c70b0ac92bb6" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- DNS preconnects for external font sources -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Optional: self-host fonts for better perf. Keeping Google Fonts for now with display=swap -->
    <!-- <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" /> -->

    <SEO {...Astro.props} />
  </head>
  <body class="flex min-h-screen flex-col">
    <ReadingProgress />
    <Header />
    <main class="flex-1"><slot /></main>
    <Footer />
  </body>
</html>
