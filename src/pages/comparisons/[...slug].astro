---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ShareButton from '../../components/ShareButton.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map(c => ({ params: { slug: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const tool1 = entry.data.tool1 || 'Tool 1';
const tool2 = entry.data.tool2 || 'Tool 2';
const category = entry.data.category || '';
const pubDate = entry.data.pubDate;
const updatedDate = entry.data.updatedDate || pubDate;
const displayDate = updatedDate;
const showUpdate = updatedDate && updatedDate > pubDate;

const pros1: string[] = (entry.data as any).pros1 || [];
const cons1: string[] = (entry.data as any).cons1 || [];
const pros2: string[] = (entry.data as any).pros2 || [];
const cons2: string[] = (entry.data as any).cons2 || [];
const features = (entry.data as any).features;
const featureRows = features && features.length > 0 ? features : [
  { feature: 'Free plan', tool1: pros1.some((p: string) => p.toLowerCase().includes('free')), tool2: pros2.some((p: string) => p.toLowerCase().includes('free')) },
  { feature: 'Mobile app', tool1: true, tool2: true },
  { feature: 'AI / Automation', tool1: true, tool2: true },
  { feature: 'Time tracking', tool1: pros1.some((p: string) => p.toLowerCase().includes('time tracking') || p.toLowerCase().includes('built-in')), tool2: pros2.some((p: string) => p.toLowerCase().includes('time tracking') || p.toLowerCase().includes('built-in')) },
  { feature: 'Integrations', tool1: '200–4,000+', tool2: '200–4,000+' },
  { feature: 'Free trial', tool1: true, tool2: true },
];

const verdictWinner = (entry.data as any).verdictWinner || '';
const verdictReason = (entry.data as any).verdictReason || '';
const verdictText = (entry.data as any).verdictText || '';

const bestFor1 = (entry.data as any).bestFor1 || '';
const bestFor2 = (entry.data as any).bestFor2 || '';

function toolSlug(name: string): string {
  return name.toLowerCase().replace(/\s+/g, '-').replace('.com', '');
}

// Extract headings for ToC
const body = entry.body || '';
const headingMatches = [...body.matchAll(/^(#{2,3})\s+(.+)$/gm)];
const headings = headingMatches.map(m => {
  const text = m[2].trim();
  const depth = m[1].length;
  const slug = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return { text, slug, depth };
});

const readTime = Math.max(3, Math.ceil(body.length / 1600));
const readTimeStr = readTime + ' min read';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://comparevue.com/' },
    { '@type': 'ListItem', position: 2, name: 'Comparisons', item: 'https://comparevue.com/comparisons/' },
    ...(category ? [{ '@type': 'ListItem', position: 3, name: category, item: `https://comparevue.com/comparisons/${category.toLowerCase().replace(/\s+/g, '-')}/` }] : []),
    { '@type': 'ListItem', position: category ? 4 : 3, name: entry.data.title },
  ],
};

const compSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: pubDate.toISOString(),
  dateModified: displayDate.toISOString(),
  author: { '@type': 'Person', name: 'CompareVue Editorial Team' },
  publisher: { '@type': 'Organization', name: 'CompareVue' },
  about: [
    { '@type': 'SoftwareApplication', name: tool1 },
    { '@type': 'SoftwareApplication', name: tool2 },
  ],
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  articlePublished={pubDate}
  articleModified={updatedDate}
  schema={compSchema}
>
  <ReadingProgress />

  <article class="relative">
    <!-- ═══ Hero Section ═══ -->
    <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
      <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>

      <div class="relative mx-auto max-w-4xl px-4 pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-14 sm:px-6 lg:px-8">
        <!-- Breadcrumbs -->
        <nav class="mb-8 text-sm" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap text-gray-400">
            <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/comparisons" class="hover:text-brand-600 transition-colors">Comparisons</a></li>
            {category && <><li aria-hidden="true">/</li><li><a href={`/comparisons/${category.toLowerCase().replace(/\s+/g, '-')}`} class="hover:text-brand-600 transition-colors">{category}</a></li></>}
          </ol>
        </nav>

        <!-- Category + meta -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-3.5 py-1.5 text-xs font-semibold text-brand-700 uppercase tracking-wide">{category || 'Comparison'}</span>
          <span class="text-sm text-gray-300 select-none">·</span>
          <span class="text-sm text-gray-500">{readTimeStr}</span>
          {showUpdate && (
            <span class="inline-flex items-center gap-1.5 text-sm text-brand-600 font-medium">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
              Updated {updatedDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </span>
          )}
        </div>

        <!-- Title -->
        <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance leading-tight tracking-tight">
          {entry.data.title}
        </h1>

        <!-- Description -->
        <p class="mt-6 text-lg sm:text-xl text-gray-500 leading-relaxed max-w-3xl text-pretty">
          {entry.data.description}
        </p>

        <!-- Meta row -->
        <div class="mt-10 flex flex-wrap items-center gap-4 pb-10 border-b border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-full bg-gradient-to-br from-brand-500 to-brand-700 flex items-center justify-center text-white text-sm font-bold ring-2 ring-white shadow-sm">CV</div>
            <div>
              <p class="text-sm font-semibold text-gray-900">CompareVue Editorial Team</p>
              <div class="flex items-center gap-2 text-xs text-gray-400">
                <time datetime={displayDate.toISOString().split('T')[0]}>
                  {displayDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
                <span aria-hidden="true">·</span>
                <span>Fact-checked</span>
              </div>
            </div>
          </div>
          <div class="ml-auto">
            <ShareButton />
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ Verdict Banner ═══ -->
    {verdictText && (
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-12">
        <div id="verdict" class="rounded-2xl bg-gradient-to-br from-green-50 to-emerald-50 border border-green-200/60 p-8 sm:p-10 scroll-mt-28">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-green-500 flex items-center justify-center text-2xl shadow-sm">🏆</div>
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-green-200/60 px-3 py-1 text-xs font-semibold text-green-800 mb-3 uppercase tracking-wide">Our Verdict</span>
              <h2 class="text-xl font-extrabold text-gray-900 mb-2">{verdictWinner} wins for {verdictReason}</h2>
              <p class="text-gray-700 leading-relaxed">{verdictText}</p>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- ═══ Jump Links ═══ -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-10">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 mr-1">Jump to:</span>
        {verdictText && (
          <a href="#verdict" class="rounded-full bg-amber-50 border border-amber-200 px-3.5 py-1.5 text-amber-700 hover:bg-amber-100 transition-colors no-underline text-xs font-medium">🏆 Verdict</a>
        )}
        <a href="#pros-cons" class="rounded-full bg-gray-100 px-3.5 py-1.5 text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors no-underline text-xs font-medium">👍 Pros & Cons</a>
        <a href="#feature-comparison" class="rounded-full bg-gray-100 px-3.5 py-1.5 text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors no-underline text-xs font-medium">📊 Features</a>
        <a href="#pricing" class="rounded-full bg-gray-100 px-3.5 py-1.5 text-gray-600 hover:bg-brand-50 hover:text-brand-700 transition-colors no-underline text-xs font-medium">💰 Pricing</a>
        <a href="#try-them" class="rounded-full bg-brand-100 px-3.5 py-1.5 text-brand-700 hover:bg-brand-200 transition-colors no-underline text-xs font-semibold">🚀 Try Them</a>
      </div>
    </div>

    <!-- ═══ Best-For Cards ═══ -->
    {(bestFor1 || bestFor2) && (
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-8">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-xl border border-brand-200 bg-brand-50/50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-brand-500 mb-1.5">Best For</p>
            <p class="text-sm font-semibold text-brand-900">{tool1}</p>
            <p class="text-sm text-brand-700/80 mt-0.5">{bestFor1}</p>
          </div>
          <div class="rounded-xl border border-gray-200 bg-gray-50/50 p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-1.5">Best For</p>
            <p class="text-sm font-semibold text-gray-900">{tool2}</p>
            <p class="text-sm text-gray-600 mt-0.5">{bestFor2}</p>
          </div>
        </div>
      </div>
    )}

    <!-- ═══ Layout: Sidebar + Content ═══ -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-16">
      <div class="flex gap-12 lg:gap-16">
        <!-- Sidebar: Table of Contents (desktop) -->
        <aside class="hidden w-56 shrink-0 lg:block">
          <div class="sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-8">
            <p class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-5">On This Page</p>
            <TableOfContents headings={headings} />
            <div class="mt-6 rounded-xl bg-brand-50 p-4 border border-brand-100">
              <p class="text-xs font-semibold text-brand-800 mb-2">Ready to decide?</p>
              <a href="#try-them" class="inline-flex w-full justify-center rounded-lg bg-brand-600 px-4 py-2 text-xs font-semibold text-white hover:bg-brand-700 transition no-underline">
                Try {tool1} & {tool2} →
              </a>
            </div>
          </div>
        </aside>

        <!-- Main content column -->
        <div class="min-w-0 flex-1">
          <!-- Prose article body -->
          <div class="prose prose-lg prose-gray max-w-none
            prose-headings:font-extrabold prose-headings:tracking-tight prose-headings:text-gray-900 prose-headings:scroll-mt-28
            prose-h2:text-2xl prose-h2:mt-16 prose-h2:mb-6
            prose-h3:text-xl prose-h3:mt-12 prose-h3:mb-5
            prose-p:leading-relaxed prose-p:text-gray-700 prose-p:mb-6
            prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
            prose-strong:text-gray-900 prose-strong:font-semibold
            prose-blockquote:border-l-4 prose-blockquote:border-brand-400 prose-blockquote:bg-brand-50/50 prose-blockquote:py-5 prose-blockquote:px-6 prose-blockquote:rounded-r-xl prose-blockquote:not-italic prose-blockquote:text-gray-700 prose-blockquote:my-8
            prose-li:marker:text-gray-400 prose-li:my-1.5
            prose-img:rounded-xl prose-img:shadow-md prose-img:my-10
            prose-hr:border-gray-200 prose-hr:my-12
            prose-code:bg-brand-50 prose-code:text-brand-700 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:before:content-none prose-code:after:content-none
            [&_table]:w-full [&_table]:text-sm [&_table]:border-collapse [&_table]:rounded-xl [&_table]:overflow-hidden [&_table]:my-10
            [&_thead]:bg-gray-50 [&_th]:px-4 [&_th]:py-3 [&_th]:text-left [&_th]:text-xs [&_th]:font-semibold [&_th]:text-gray-500 [&_th]:uppercase [&_th]:tracking-wider
            [&_td]:px-4 [&_td]:py-3.5 [&_td]:border-t [&_td]:border-gray-100 [&_td]:text-gray-700
            [&_tr:hover_td]:bg-brand-50/30
            [&_table]:border [&_table]:border-gray-200
          ">
            <Content />
          </div>

          <!-- Mobile ToC -->
          <details class="mt-10 rounded-xl border border-gray-200 bg-gray-50 lg:hidden group">
            <summary class="cursor-pointer px-6 py-4 text-sm font-semibold uppercase tracking-wider text-gray-500 select-none group-open:border-b group-open:border-gray-200">On This Page</summary>
            <div class="px-6 pb-5 pt-3"><TableOfContents headings={headings} /></div>
          </details>

          <!-- ═══ Pros & Cons ═══ -->
          <div id="pros-cons" class="mt-16 grid gap-6 sm:grid-cols-2 scroll-mt-28">
            <!-- Tool 1 -->
            <div class="rounded-2xl border border-green-200 bg-gradient-to-b from-green-50/80 to-green-50/30 p-7">
              <div class="flex items-center gap-2.5 mb-5">
                <div class="w-9 h-9 rounded-lg bg-green-500 flex items-center justify-center text-white text-sm font-bold shadow-sm">{tool1.charAt(0)}</div>
                <h3 class="font-bold text-gray-900 text-lg">{tool1}</h3>
              </div>
              <div class="mb-5">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-green-600 mb-3">Pros</h4>
                <ul class="space-y-2.5">
                  {pros1.map((p: string) => (
                    <li class="flex gap-2.5 text-sm text-gray-700 leading-relaxed">
                      <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-red-500 mb-3">Cons</h4>
                <ul class="space-y-2.5">
                  {cons1.map((c: string) => (
                    <li class="flex gap-2.5 text-sm text-gray-600 leading-relaxed">
                      <svg class="w-4 h-4 text-red-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                      {c}
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- Tool 2 -->
            <div class="rounded-2xl border border-gray-200 bg-gradient-to-b from-gray-50/80 to-white p-7">
              <div class="flex items-center gap-2.5 mb-5">
                <div class="w-9 h-9 rounded-lg bg-gray-700 flex items-center justify-center text-white text-sm font-bold shadow-sm">{tool2.charAt(0)}</div>
                <h3 class="font-bold text-gray-900 text-lg">{tool2}</h3>
              </div>
              <div class="mb-5">
                <h4 class="text-xs font-semibold uppercase tracking-wider text-green-600 mb-3">Pros</h4>
                <ul class="space-y-2.5">
                  {pros2.map((p: string) => (
                    <li class="flex gap-2.5 text-sm text-gray-700 leading-relaxed">
                      <svg class="w-4 h-4 text-green-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-red-500 mb-3">Cons</h4>
                <ul class="space-y-2.5">
                  {cons2.map((c: string) => (
                    <li class="flex gap-2.5 text-sm text-gray-600 leading-relaxed">
                      <svg class="w-4 h-4 text-red-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                      {c}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <!-- ═══ Feature Comparison Table ═══ -->
          <div id="feature-comparison" class="mt-16 scroll-mt-28">
            <ComparisonTable
              title="Feature Comparison"
              tool1={tool1}
              tool2={tool2}
              rows={featureRows}
            />
          </div>

          <!-- ═══ Visual Divider ═══ -->
          <div class="mt-16 flex items-center gap-5" aria-hidden="true">
            <div class="h-px flex-1 bg-gray-200"></div>
            <div class="flex gap-2">
              <div class="w-2 h-2 rounded-full bg-brand-400"></div>
              <div class="w-2 h-2 rounded-full bg-brand-300"></div>
              <div class="w-2 h-2 rounded-full bg-brand-200"></div>
            </div>
            <div class="h-px flex-1 bg-gray-200"></div>
          </div>

          <!-- ═══ CTA Section ═══ -->
          <div id="try-them" class="mt-16 rounded-2xl bg-gradient-to-br from-brand-600 via-brand-700 to-brand-800 p-10 sm:p-12 text-center relative overflow-hidden scroll-mt-28">
            <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 28px 28px;"></div>
            <div class="relative">
              <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3.5 py-1 text-xs font-semibold text-white/90 mb-6 uppercase tracking-wider">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                Try Them Free
              </span>
              <h3 class="text-2xl font-bold text-white mb-4">Ready to see for yourself?</h3>
              <p class="text-brand-200/90 leading-relaxed max-w-md mx-auto text-base">
                Both {tool1} and {tool2} offer free trials. Click below to explore — and help support CompareVue at no extra cost.
              </p>
              <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
                <a href={'/go/' + toolSlug(tool1)} rel="nofollow sponsored" class="inline-flex items-center gap-2 rounded-xl bg-white px-8 py-3.5 text-sm font-bold text-brand-700 hover:bg-brand-50 transition shadow-lg shadow-black/10 hover:shadow-xl hover:shadow-black/15">
                  Try {tool1} Free →
                </a>
                <a href={'/go/' + toolSlug(tool2)} rel="nofollow sponsored" class="inline-flex items-center gap-2 rounded-xl border-2 border-white/30 bg-white/10 backdrop-blur px-8 py-3.5 text-sm font-bold text-white hover:bg-white/20 transition">
                  Try {tool2} Free →
                </a>
              </div>
              <p class="mt-5 text-xs text-brand-300/80">We may earn a commission if you sign up through these links, at no extra cost to you.</p>
            </div>
          </div>

          <!-- ═══ Share ═══ -->
          <div class="mt-10 pb-6 flex items-center justify-center gap-2.5">
            <span class="text-xs text-gray-400 mr-2">Share this comparison:</span>
            <ShareButton />
          </div>
        </div>
      </div>
    </div>

    <!-- ═══ Related Content ═══ -->
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 mt-4">
      <RelatedContent currentSlug={entry.id} category={category} type="comparisons" />
    </div>

    <!-- Breadcrumb schema -->
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
  </article>

  <!-- Table of Contents scroll spy -->
  <script>
    function initTocSpy() {
      const headings = document.querySelectorAll('h2[id], h3[id]');
      const tocNav = document.querySelector('aside nav');
      if (!tocNav || headings.length === 0) return;
      const tocLinks = tocNav.querySelectorAll('a[href^="#"]');
      if (tocLinks.length === 0) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(link => {
              link.classList.remove('text-brand-600', 'font-semibold', 'border-brand-500');
              link.classList.add('text-gray-500', 'border-transparent');
              if (link.getAttribute('href') === '#' + entry.target.id) {
                link.classList.add('text-brand-600', 'font-semibold', 'border-brand-500');
                link.classList.remove('text-gray-500', 'border-transparent');
              }
            });
          }
        });
      }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });

      headings.forEach(h => observer.observe(h));
    }

    initTocSpy();
  </script>
</BaseLayout>
