---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const sorted = comparisons.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Extract unique categories
const allCats = [...new Set(comparisons.map(c => c.data.category))].sort();
const catParam = Astro.url.searchParams.get('category') || 'All';
const filtered = catParam === 'All' ? sorted : sorted.filter(c => c.data.category === catParam);
---

<BaseLayout
  title="Software Comparisons"
  description="Head-to-head SaaS comparisons across CRM, project management, finance, marketing, and more."
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-gray-900">Software Comparisons</h1>
    <p class="mt-2 text-gray-600">{comparisons.length} comparisons and growing.</p>

    <!-- Category Filter -->
    <div class="mt-6 flex flex-wrap gap-2" id="category-filters">
      <button data-category="All"
        class="filter-btn rounded-full px-4 py-1.5 text-sm font-medium transition bg-brand-600 text-white">
        All
      </button>
      {allCats.map(cat => (
        <button data-category={cat}
          class="filter-btn rounded-full px-4 py-1.5 text-sm font-medium transition bg-gray-100 text-gray-600 hover:bg-gray-200">
          {cat}
        </button>
      ))}
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="comparison-grid">
      {sorted.map(c => (
        <div class="comparison-card" data-category={c.data.category}>
          <ArticleCard title={c.data.title} description={c.data.description}
            slug={'/comparisons/' + c.id} date={c.data.pubDate} category={c.data.category} />
        </div>
      ))}
    </div>

    <p id="no-results" class="mt-12 text-center text-gray-500 hidden">No comparisons in this category yet. <a href="/contact" class="text-brand-600 hover:underline">Suggest one?</a></p>

    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.comparison-card');
      const noResults = document.getElementById('no-results');
      const grid = document.getElementById('comparison-grid');

      // Read initial category from URL
      const params = new URLSearchParams(window.location.search);
      const activeCat = params.get('category') || 'All';

      function filter(category) {
        let visible = 0;
        cards.forEach(card => {
          if (category === 'All' || card.dataset.category === category) {
            card.style.display = '';
            visible++;
          } else {
            card.style.display = 'none';
          }
        });
        noResults.classList.toggle('hidden', visible > 0);
        grid.classList.toggle('hidden', visible === 0);

        // Update active button
        buttons.forEach(btn => {
          const isActive = btn.dataset.category === category;
          btn.classList.toggle('bg-brand-600', isActive);
          btn.classList.toggle('text-white', isActive);
          btn.classList.toggle('bg-gray-100', !isActive);
          btn.classList.toggle('text-gray-600', !isActive);
        });

        // Update URL without reload
        const url = new URL(window.location);
        if (category === 'All') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', category);
        }
        window.history.replaceState({}, '', url);
      }

      // Apply initial filter from URL
      filter(activeCat);

      // Click handlers
      buttons.forEach(btn => {
        btn.addEventListener('click', () => filter(btn.dataset.category));
      });
    </script>
  </section>
</BaseLayout>
