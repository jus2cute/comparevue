---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const sorted = comparisons.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allCats = [...new Set(comparisons.map(c => c.data.category))].sort();
const countByCat = Object.fromEntries(allCats.map(cat => [cat, comparisons.filter(c => c.data.category === cat).length]));

// Featured comparisons (first 3 most recent with featured flag or fresh ones)
const featured = sorted.filter(c => c.data.featured).slice(0, 3);
const hasFeatured = featured.length > 0;
---

<BaseLayout
  title="Software Comparisons 2026 — Compare Top SaaS Tools"
  description={`${comparisons.length} head-to-head SaaS comparisons across CRM, project management, productivity, and more. Real pricing, feature tables, and verdicts.`}
>
  <!-- ═══ Hero ═══ -->
  <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-14 sm:px-6 lg:px-8">
      <nav class="mb-6 text-sm text-gray-400" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-500" aria-current="page">Comparisons</li>
        </ol>
      </nav>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-3.5 py-1.5 text-xs font-semibold text-brand-700 uppercase tracking-wide mb-6">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        Updated June 2026 · {comparisons.length} comparisons
      </span>
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance leading-tight tracking-tight">
        Software <span class="text-brand-600">Comparisons</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-500 max-w-3xl text-pretty leading-relaxed">{comparisons.length} head-to-head comparisons with real pricing, feature breakdowns, and honest verdicts — no fluff, no sponsored rankings.</p>
    </div>
  </header>

  <!-- ═══ Content ═══ -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Category filter pills -->
    <div class="flex flex-wrap gap-2 mb-12">
      <span class="rounded-full px-4 py-2 text-sm font-semibold bg-brand-600 text-white shadow-sm">All ({comparisons.length})</span>
      {allCats.map(cat => {
        const slug = cat.toLowerCase().replace(/\s+/g, '-');
        const n = countByCat[cat] || 0;
        return (
          <a href={`/comparisons/${slug}`}
            class="rounded-full px-4 py-2 text-sm font-medium transition bg-gray-100 text-gray-600 hover:bg-brand-50 hover:text-brand-600">
            {cat} ({n})
          </a>
        );
      })}
    </div>

    {hasFeatured && (
      <div class="mb-14">
        <h2 class="text-lg font-bold text-gray-900 mb-5 flex items-center gap-2">
          <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Featured Comparisons
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map(c => {
            const rt = Math.max(1, Math.ceil(c.data.description.length / 120));
            return (
            <ArticleCard title={c.data.title} description={c.data.description}
              slug={'/comparisons/' + c.id} date={c.data.pubDate} updatedDate={c.data.updatedDate} category={c.data.category} readTime={rt + ' min read'} />
          )})}
        </div>
      </div>
    )}

    {comparisons.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 p-16 text-center">
        <p class="text-gray-500 text-lg">No comparisons yet. Check back soon!</p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map(c => {
          const rt = Math.max(1, Math.ceil(c.data.description.length / 120));
          return (
          <ArticleCard title={c.data.title} description={c.data.description}
            slug={'/comparisons/' + c.id} date={c.data.pubDate} updatedDate={c.data.updatedDate} category={c.data.category} readTime={rt + ' min read'} />
        )})}
      </div>
    )}
  </section>
</BaseLayout>
