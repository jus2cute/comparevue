---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const sorted = comparisons.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Software Comparisons"
  description="Head-to-head SaaS comparisons across CRM, project management, finance, marketing, and more."
>
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-gray-900">Software Comparisons</h1>
    <p class="mt-2 text-gray-600">{comparisons.length} comparisons and growing.</p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sorted.map(c => (
        <ArticleCard title={c.data.title} description={c.data.description}
          slug={'/comparisons/' + c.id} date={c.data.pubDate} category={c.data.category} />
      ))}
    </div>
  </section>
</BaseLayout>
