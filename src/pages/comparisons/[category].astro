---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  const allCats = [...new Set(comparisons.map(c => c.data.category))].sort();
  return allCats.map(cat => ({ params: { category: cat.toLowerCase().replace(/\s+/g, '-') }, props: { category: cat } }));
}

const { category } = Astro.props;
const comparisons = await getCollection('comparisons');
const filtered = comparisons
  .filter(c => c.data.category === category)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allCats = [...new Set(comparisons.map(c => c.data.category))].sort();
const countByCat = Object.fromEntries(allCats.map(cat => [cat, comparisons.filter(c => c.data.category === cat).length]));

const catLower = category.toLowerCase();

// Category-specific rich descriptions
const categoryMeta: Record<string, { hero: string; intro: string; tools: string; why: string }> = {
  'CRM': {
    hero: 'Compare the top CRM platforms side by side — HubSpot, Salesforce, Zoho, Pipedrive, Freshsales, and more.',
    intro: "Choosing the right CRM is one of the most consequential software decisions a growing business makes. The right CRM becomes your team's central nervous system — tracking deals, automating follow-ups, and keeping customer relationships organized. The wrong one becomes shelfware your sales team resents.",
    tools: 'HubSpot, Salesforce, Zoho CRM, Pipedrive, Freshsales',
    why: "We test each CRM hands-on: setting up pipelines, running reports, configuring automations, and evaluating the interface from a real user's perspective — not a demo video.",
  },
  'Project Management': {
    hero: 'Head-to-head comparisons of the best project management tools — ClickUp, Jira, Asana, Monday.com, Wrike, Trello, and more.',
    intro: "Project management software is the backbone of team productivity. Whether you're running agile sprints, managing client deliverables, or coordinating cross-functional initiatives, the right PM tool keeps work visible, accountable, and on schedule. The wrong one creates more process than progress.",
    tools: 'ClickUp, Jira, Asana, Monday.com, Wrike, Trello',
    why: 'We test every PM tool with real projects: creating tasks, setting dependencies, building dashboards, configuring automations, and evaluating how each tool handles teams of different sizes and workflows.',
  },
  'Productivity': {
    hero: 'Compare the best productivity and all-in-one workspaces — Notion, ClickUp, Asana, and more.',
    intro: "Productivity tools have evolved beyond simple to-do lists. Modern workspaces combine docs, databases, task management, and collaboration into unified platforms. The question isn't which tool has the most features — it's which tool fits how your team actually works.",
    tools: 'Notion, ClickUp, Asana',
    why: 'We use each productivity tool as our daily driver for weeks — building wikis, tracking projects, managing databases — to understand the real experience, not just the feature list.',
  },
  'Documentation': {
    hero: 'Compare the leading documentation and wiki tools — Notion, Confluence, and more.',
    intro: "Great documentation doesn't happen by accident. It requires a tool that makes writing, organizing, and finding information effortless. The best documentation platforms become your team's collective memory — the worst become graveyards of outdated pages nobody reads.",
    tools: 'Notion, Confluence',
    why: 'We evaluate documentation tools on search quality, editor experience, organizational structure, and how well they integrate with the tools engineering and product teams already use.',
  },
  'Email Marketing': {
    hero: 'Compare the best email marketing platforms — Mailchimp, Brevo, and more.',
    intro: "Email marketing remains the highest-ROI channel for most businesses — but only if you're using the right platform. The best email tools balance ease of use with advanced automation, segmentation, and deliverability. The worst overcharge for features you'll never use.",
    tools: 'Mailchimp, Brevo (Sendinblue)',
    why: 'We test email marketing tools by building real campaigns: creating automations, designing emails, analyzing deliverability, and evaluating pricing at different list sizes.',
  },
  'Team Communication': {
    hero: 'Compare the top team communication platforms — Slack, Microsoft Teams, and more.',
    intro: "Team communication tools are where work actually happens — discussions, decisions, quick questions, and async updates. The right platform reduces email and keeps conversations organized. The wrong one creates notification fatigue and message overload.",
    tools: 'Slack, Microsoft Teams',
    why: 'We use each communication tool as our primary messaging platform — evaluating search, integrations, channel organization, video/voice quality, and the overall daily experience.',
  },
};

const meta = categoryMeta[category] || {
  hero: `${filtered.length} in-depth ${catLower} software comparisons — real pricing, feature breakdowns, and honest verdicts.`,
  intro: `We compare the top ${catLower} tools head-to-head with real pricing data, hands-on testing, and honest verdicts — no sponsored reviews, no fluff.`,
  tools: '',
  why: 'Every comparison is fact-checked and updated regularly so you get current, actionable information.',
};

// Count unique tools in this category
const toolNames = new Set<string>();
filtered.forEach(c => {
  if (c.data.tool1) toolNames.add(c.data.tool1);
  if (c.data.tool2) toolNames.add(c.data.tool2);
});
---

<BaseLayout
  title={`${category} Software Comparisons 2026 — Compare Top ${category} Tools`}
  description={`${filtered.length} in-depth ${catLower} tool comparisons with pricing, feature tables, pros & cons, and honest verdicts. Compare ${meta.tools || catLower} tools.`}
>
  <!-- ═══ Hero ═══ -->
  <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-14 sm:px-6 lg:px-8">
      <nav class="mb-6 text-sm text-gray-400" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/comparisons" class="hover:text-brand-600 transition-colors">Comparisons</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-500" aria-current="page">{category}</li>
        </ol>
      </nav>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-3.5 py-1.5 text-xs font-semibold text-brand-700 uppercase tracking-wide mb-6">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
        {filtered.length} comparison{filtered.length !== 1 ? 's' : ''} · {toolNames.size} tool{toolNames.size !== 1 ? 's' : ''} compared
      </span>
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance leading-tight tracking-tight">
        {category} Software <span class="text-brand-600">Comparisons</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-500 leading-relaxed max-w-3xl text-pretty">{meta.hero}</p>
    </div>
  </header>

  <!-- ═══ Stats Bar ═══ -->
  <section class="border-y border-gray-100 bg-white">
    <div class="mx-auto max-w-4xl px-4 py-8 sm:py-10 grid grid-cols-3 gap-6 text-center">
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-brand-600">{filtered.length}</div>
        <div class="mt-1 text-xs sm:text-sm text-gray-500">Head-to-Head Comparisons</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-brand-600">{toolNames.size}</div>
        <div class="mt-1 text-xs sm:text-sm text-gray-500">Tools Reviewed</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-extrabold text-brand-600">2026</div>
        <div class="mt-1 text-xs sm:text-sm text-gray-500">Updated & Current</div>
      </div>
    </div>
  </section>

  <!-- ═══ Intro Content ═══ -->
  <section class="mx-auto max-w-4xl px-4 py-12 sm:py-16 sm:px-6 lg:px-8">
    <div class="prose prose-lg prose-gray max-w-none">
      <p class="text-gray-700 leading-relaxed text-lg">{meta.intro}</p>
      {meta.tools && (
        <p class="text-gray-700 leading-relaxed">We cover: <strong>{meta.tools}</strong>.</p>
      )}
      <p class="text-gray-600 text-sm leading-relaxed italic border-l-4 border-brand-300 pl-5 py-1">{meta.why}</p>
    </div>
  </section>

  <!-- ═══ Comparison Cards ═══ -->
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <!-- Category filter pills -->
    <div class="flex flex-wrap gap-2 mb-12">
      <a href="/comparisons" class="rounded-full px-4 py-2 text-sm font-medium transition bg-gray-100 text-gray-600 hover:bg-brand-50 hover:text-brand-600">All ({comparisons.length})</a>
      {allCats.map(cat => {
        const slug = cat.toLowerCase().replace(/\s+/g, '-');
        const isActive = cat === category;
        const n = countByCat[cat] || 0;
        return (
          <a href={`/comparisons/${slug}`}
            class={`rounded-full px-4 py-2 text-sm font-medium transition ${isActive ? 'bg-brand-600 text-white shadow-sm font-semibold' : 'bg-gray-100 text-gray-600 hover:bg-brand-50 hover:text-brand-600'}`}>
            {cat} ({n})
          </a>
        );
      })}
    </div>

    {filtered.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 p-16 text-center">
        <p class="text-gray-500 text-lg">No {catLower} comparisons yet.</p>
        <a href="/comparisons" class="mt-4 inline-flex items-center gap-2 text-brand-600 hover:underline font-medium">← Browse all comparisons</a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {filtered.map(c => {
          const rt = Math.max(1, Math.ceil(c.data.description.length / 120));
          return (
          <ArticleCard title={c.data.title} description={c.data.description}
            slug={'/comparisons/' + c.id} date={c.data.pubDate} updatedDate={c.data.updatedDate} category={c.data.category} readTime={rt + ' min read'} />
        )})}
      </div>
    )}
  </section>
</BaseLayout>
