---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const comparisons = await getCollection('comparisons');
const articles = await getCollection('articles');

const all = [
  ...comparisons.map(c => ({
    title: c.data.title,
    description: c.data.description,
    category: c.data.category,
    url: '/comparisons/' + c.id,
    type: 'Comparison',
  })),
  ...articles.map(a => ({
    title: a.data.title,
    description: a.data.description,
    category: a.data.category,
    url: '/articles/' + a.id,
    type: 'Article',
  })),
];

const searchSchema = {
  '@context': 'https://schema.org',
  '@type': 'SearchAction',
  target: {
    '@type': 'EntryPoint',
    urlTemplate: 'https://comparevue.com/search?q={search_term_string}',
  },
  'query-input': 'required name=search_term_string',
};
---

<BaseLayout
  title="Search CompareVue"
  description="Search our library of SaaS comparisons and buying guides."
  schema={searchSchema}
>
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl">Search</h1>
    <p class="mt-3 text-gray-600">Find comparisons and guides across {all.length} pages.</p>

    <div class="mt-8">
      <div class="relative">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
        <input
          id="search-input"
          type="search"
          placeholder="Search comparisons & articles…"
          class="w-full rounded-xl border border-gray-300 bg-white py-3.5 pl-12 pr-4 text-lg text-gray-900 placeholder:text-gray-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none transition"
          autofocus
          autocomplete="off"
        />
      </div>
    </div>

    <div id="search-results" class="mt-6 space-y-3">
      <p class="text-sm text-gray-400 py-8 text-center">Start typing to search…</p>
    </div>

    <div id="search-stats" class="mt-4 text-sm text-gray-400 text-center hidden"></div>
  </section>
</BaseLayout>

<script is:inline>
  window.__SEARCH_INDEX__ = {JSON.stringify(all)};
</script>
<script>
  const INDEX = window.__SEARCH_INDEX__;

  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const stats = document.getElementById('search-stats');

  function search(query) {
    const q = query.toLowerCase().trim();
    if (!q) {
      results.innerHTML = '<p class="text-sm text-gray-400 py-8 text-center">Start typing to search…</p>';
      stats.classList.add('hidden');
      return;
    }

    const hits = INDEX.filter(item => {
      return item.title.toLowerCase().includes(q) ||
             item.description.toLowerCase().includes(q) ||
             item.category.toLowerCase().includes(q);
    });

    stats.classList.remove('hidden');
    stats.textContent = hits.length === 1 ? '1 result' : hits.length + ' results';

    if (hits.length === 0) {
      results.innerHTML = '<p class="text-sm text-gray-400 py-8 text-center">No results for "' + query + '". Try a different search term.</p>';
      return;
    }

    results.innerHTML = hits.map(item => `
      <a href="${item.url}" class="flex items-start gap-4 rounded-xl border border-gray-200 bg-white p-5 transition hover:border-brand-200 hover:shadow-sm no-underline group">
        <span class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wider ${item.type === 'Comparison' ? 'bg-brand-100 text-brand-700' : 'bg-amber-100 text-amber-700'}">${item.type}</span>
        <div class="min-w-0 flex-1">
          <h3 class="text-base font-semibold text-gray-900 group-hover:text-brand-600 truncate">${escapeHtml(item.title)}</h3>
          <p class="mt-1 text-sm text-gray-500 line-clamp-2">${escapeHtml(item.description)}</p>
          <span class="mt-1 inline-flex items-center gap-1 text-xs text-gray-400">${escapeHtml(item.category)}</span>
        </div>
        <svg class="shrink-0 w-4 h-4 text-gray-300 group-hover:text-brand-500 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    `).join('');
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  input?.addEventListener('input', (e) => search(e.target.value));

  // Check URL params on load
  const urlParams = new URLSearchParams(window.location.search);
  const q = urlParams.get('q');
  if (q) {
    input.value = q;
    search(q);
  }
</script>
