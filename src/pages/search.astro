---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const comparisons = await getCollection('comparisons');
const articles = await getCollection('articles');

const all = [
  ...comparisons.map(c => ({
    title: c.data.title,
    description: c.data.description,
    category: c.data.category,
    url: '/comparisons/' + c.id,
    type: 'Comparison',
  })),
  ...articles.map(a => ({
    title: a.data.title,
    description: a.data.description,
    category: a.data.category,
    url: '/articles/' + a.id,
    type: 'Article',
  })),
];

const searchSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CompareVue',
  url: 'https://comparevue.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://comparevue.com/search?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};

// Popular search suggestions
const popular = [
  { term: 'CRM', label: 'CRM tools' },
  { term: 'HubSpot', label: 'HubSpot' },
  { term: 'ClickUp', label: 'ClickUp' },
  { term: 'project management', label: 'Project Management' },
  { term: 'Asana', label: 'Asana' },
  { term: 'Salesforce', label: 'Salesforce' },
  { term: 'Notion', label: 'Notion' },
  { term: 'email marketing', label: 'Email Marketing' },
];
---

<BaseLayout
  title="Search"
  description="Search our library of SaaS comparisons and buying guides."
  schema={searchSchema}
>
  <!-- ═══ Hero ═══ -->
  <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-14 sm:pt-20 pb-10 sm:pb-14 sm:px-6 lg:px-8">
      <nav class="mb-6 text-sm text-gray-400" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-500" aria-current="page">Search</li>
        </ol>
      </nav>
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl tracking-tight">Search</h1>
      <p class="mt-4 text-lg sm:text-xl text-gray-500 max-w-2xl text-pretty">Search across {all.length} comparisons and guides.</p>
    </div>
  </header>

  <!-- ═══ Content ═══ -->
  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="relative mb-8">
      <svg class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        id="search-input"
        type="search"
        placeholder="Search comparisons & articles…"
        class="w-full rounded-2xl border border-gray-200 bg-white py-4 pl-14 pr-4 text-lg text-gray-900 placeholder:text-gray-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none transition shadow-sm"
        autofocus
        autocomplete="off"
      />
    </div>

    <!-- Popular quick links -->
    <div class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Popular Searches</p>
      <div class="flex flex-wrap gap-2">
        {popular.map(p => (
          <button type="button" class="quick-chip rounded-full border border-gray-200 bg-white px-4 py-2 text-sm text-gray-600 hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50 transition cursor-pointer" data-query={p.term}>{p.label}</button>
        ))}
      </div>
    </div>

    <div id="search-stats" class="mb-4 text-sm text-gray-400 hidden"></div>

    <div id="search-results" class="space-y-3">
      <p class="text-sm text-gray-400 py-12 text-center">Start typing to search or pick a popular topic above…</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  window.__SEARCH_INDEX__ = {JSON.stringify(all)};
</script>
<script>
  const INDEX = window.__SEARCH_INDEX__;

  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const stats = document.getElementById('search-stats');

  function search(query) {
    const q = query.toLowerCase().trim();
    if (!q) {
      results.innerHTML = '<p class="text-sm text-gray-400 py-12 text-center">Start typing to search or pick a popular topic above…</p>';
      stats.classList.add('hidden');
      return;
    }

    const hits = INDEX.filter(item => {
      return item.title.toLowerCase().includes(q) ||
             item.description.toLowerCase().includes(q) ||
             item.category.toLowerCase().includes(q);
    });

    stats.classList.remove('hidden');
    stats.textContent = hits.length === 1 ? '1 result' : hits.length + ' results';

    if (hits.length === 0) {
      results.innerHTML = '<p class="text-sm text-gray-400 py-12 text-center">No results matching "' + query + '". Try a different search term.</p>';
      return;
    }

    results.innerHTML = hits.map(function(item) {
      return (
        '<a href="' + item.url + '" class="flex items-start gap-4 rounded-2xl border border-gray-200 bg-white p-5 transition-all duration-200 hover:border-brand-200 hover:shadow-md hover:-translate-y-0.5 no-underline group">' +
          '<span class="shrink-0 rounded-lg px-2.5 py-1 text-xs font-semibold uppercase tracking-wider ' + (item.type === 'Comparison' ? 'bg-brand-100 text-brand-700' : 'bg-amber-100 text-amber-700') + '">' + item.type + '</span>' +
          '<div class="min-w-0 flex-1">' +
            '<h3 class="text-base font-semibold text-gray-900 group-hover:text-brand-600 transition-colors truncate">' + escapeHtml(item.title) + '</h3>' +
            '<p class="mt-1 text-sm text-gray-500 line-clamp-2 leading-relaxed">' + escapeHtml(item.description) + '</p>' +
            '<span class="mt-1.5 inline-block text-xs text-gray-400">' + escapeHtml(item.category) + '</span>' +
          '</div>' +
          '<svg class="shrink-0 w-4 h-4 text-gray-300 group-hover:text-brand-500 group-hover:translate-x-0.5 transition-all mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>' +
        '</a>'
      );
    }).join('');
  }

  function escapeHtml(str) {
    var div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  // Quick chip buttons
  document.querySelectorAll('.quick-chip').forEach(function(chip) {
    chip.addEventListener('click', function() {
      var q = this.getAttribute('data-query');
      input.value = q;
      input.focus();
      search(q);
    });
  });

  input && input.addEventListener('input', function(e) { search(e.target.value); });

  var urlParams = new URLSearchParams(window.location.search);
  var q = urlParams.get('q');
  if (q) { input.value = q; search(q); }
</script>
