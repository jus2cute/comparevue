---
import affiliateLinks from '../../data/affiliate-links.json';

export async function getStaticPaths() {
  const keys = Object.keys(affiliateLinks);
  return keys.map(tool => ({ params: { tool } }));
}

const { tool } = Astro.params;
const link = affiliateLinks[tool as keyof typeof affiliateLinks];

// Build redirect URL with UTM tracking
// Priority: direct affiliate URL > baseUrl with UTM params
let redirectUrl: string;
if (link?.directUrl) {
  redirectUrl = link.directUrl;
} else {
  const baseUrl = link?.baseUrl || '/';
  const utmParams = `utm_source=comparevue&utm_medium=referral&utm_campaign=${encodeURIComponent(tool)}`;
  redirectUrl = baseUrl.includes('?') ? `${baseUrl}&${utmParams}` : `${baseUrl}?${utmParams}`;
}

const toolName = link?.name || tool;
---

<!doctype html>
<html lang="en">
<head>
<!-- Impact site verification — must be first in <head> -->
<meta name="impact-site-verification" value="5f9d5c67-21fd-436e-ab92-c70b0ac92bb6" />
<meta charset="UTF-8" />
<meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
<link rel="canonical" href={redirectUrl} />
<title>Redirecting to {toolName}…</title>
</head>
<body>
<p>Redirecting to <a href={redirectUrl}>{toolName}</a>…</p>
</body>
</html>
