---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const articles = await getCollection('articles');
const sorted = articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allCats = [...new Set(articles.map(a => a.data.category))].sort();
const countByCat = Object.fromEntries(allCats.map(cat => [cat, articles.filter(a => a.data.category === cat).length]));
---

<BaseLayout
  title="Articles & Guides — SaaS Buying Advice"
  description={`${articles.length} in-depth guides, best-of lists, and how-tos covering CRM, project management, email marketing, and more SaaS tools.`}
>
  <!-- ═══ Hero ═══ -->
  <header class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-14 sm:pt-20 lg:pt-24 pb-10 sm:pb-14 sm:px-6 lg:px-8">
      <nav class="mb-6 text-sm text-gray-400" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 flex-wrap">
          <li><a href="/" class="hover:text-brand-600 transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-gray-500" aria-current="page">Articles</li>
        </ol>
      </nav>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-3.5 py-1.5 text-xs font-semibold text-brand-700 uppercase tracking-wide mb-6">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
        {articles.length} guides · {allCats.length} categories
      </span>
      <h1 class="text-3xl font-extrabold text-gray-900 sm:text-4xl lg:text-5xl text-balance leading-tight tracking-tight">
        Articles & <span class="text-brand-600">Guides</span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-500 max-w-3xl text-pretty leading-relaxed">{articles.length} in-depth guides, best-of lists, and how-tos — researched and written for real users, not algorithms.</p>
    </div>
  </header>

  <!-- ═══ Content ═══ -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <!-- Category filter pills -->
    {allCats.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-12">
        <span class="rounded-full px-4 py-2 text-sm font-semibold bg-brand-600 text-white shadow-sm">All ({articles.length})</span>
        {allCats.map(cat => {
          const n = countByCat[cat] || 0;
          return (
            <span class="rounded-full px-4 py-2 text-sm font-medium bg-gray-100 text-gray-600">
              {cat} ({n})
            </span>
          );
        })}
      </div>
    )}

    {articles.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-gray-200 bg-gray-50 p-16 text-center">
        <p class="text-gray-500 text-lg">No articles yet. Check back soon!</p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map(a => {
          const rt = Math.max(1, Math.ceil(a.data.description.length / 120));
          return (
          <ArticleCard title={a.data.title} description={a.data.description} slug={a.id}
            date={a.data.pubDate} updatedDate={a.data.updatedDate} category={a.data.category} readTime={rt + ' min read'} />
        )})}
      </div>
    )}
  </section>
</BaseLayout>
