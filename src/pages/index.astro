---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const articles = await getCollection('articles');

const topComps = comparisons.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 6);
const topArts = articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 6);

const latestUpdate = [...comparisons, ...articles].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())[0];

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CompareVue',
  url: 'https://comparevue.com',
  description: 'Honest, data-driven SaaS and software comparisons to help you pick the right tools.',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: 'https://comparevue.com/search?q={search_term_string}' },
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="CompareVue — Smart SaaS Comparisons"
  description="Honest, data-driven comparisons between 20+ top SaaS tools. Real pricing, feature breakdowns, and hands-on verdicts — no fluff."
  schema={siteSchema}
>
  <!-- ═══ Hero ═══ -->
  <section class="relative overflow-hidden bg-gradient-to-b from-brand-50/60 via-white to-white">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="relative mx-auto max-w-4xl px-4 pt-16 sm:pt-24 lg:pt-28 pb-12 sm:pb-16 text-center sm:px-6 lg:px-8">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100/80 px-4 py-1.5 text-xs font-semibold text-brand-700 mb-6 uppercase tracking-wide">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Updated {latestUpdate?.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })} · {comparisons.length} comparisons
      </span>

      <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl lg:text-6xl tracking-tight leading-tight text-balance">
        Find the Right Software<br />
        <span class="text-brand-600">Without the Guesswork</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg sm:text-xl text-gray-500 leading-relaxed text-pretty">
        Honest, data-driven comparisons between the top SaaS tools. We test the features, compare the pricing, and help you decide — fast.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/comparisons" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-8 py-4 text-lg font-bold text-white hover:bg-brand-700 transition shadow-lg shadow-brand-600/20 hover:shadow-xl hover:shadow-brand-600/30">
          Compare Tools
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
        <a href="/articles" class="rounded-xl border-2 border-gray-200 bg-white px-8 py-4 text-lg font-bold text-gray-700 transition hover:border-brand-200 hover:text-brand-600 shadow-sm">
          Read Guides
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Trust Bar ═══ -->
  <section class="border-y border-gray-100 bg-white">
    <div class="mx-auto max-w-4xl px-4 py-10 sm:py-12 grid grid-cols-3 gap-8 text-center">
      <div>
        <div class="text-3xl font-extrabold text-brand-600">{comparisons.length}</div>
        <div class="mt-1.5 text-sm text-gray-500">Head-to-Head Comparisons</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand-600">{articles.length}</div>
        <div class="mt-1.5 text-sm text-gray-500">In-Depth Guides</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand-600">Monthly</div>
        <div class="mt-1.5 text-sm text-gray-500">Updated & Fact-Checked</div>
      </div>
    </div>
  </section>

  <!-- ═══ Comparisons ═══ -->
  <section class="py-20 sm:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900 sm:text-3xl">Head-to-Head Comparisons</h2>
          <p class="mt-3 text-gray-500 text-lg">See how the top tools stack up side by side.</p>
        </div>
        <a href="/comparisons" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
          View all {comparisons.length}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topComps.map(c => {
          const rt = Math.max(1, Math.ceil(c.data.description.length / 120));
          return (
          <ArticleCard title={c.data.title} description={c.data.description}
            slug={'/comparisons/' + c.id} date={c.data.pubDate} category={c.data.category} readTime={rt + ' min read'} />
        )})}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/comparisons" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
          View all {comparisons.length} comparisons
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Articles ═══ -->
  <section class="py-20 sm:py-24 bg-gray-50/70">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-10">
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900 sm:text-3xl">Latest Guides & Best-Of Lists</h2>
          <p class="mt-3 text-gray-500 text-lg">In-depth buying guides researched and written for real users.</p>
        </div>
        <a href="/articles" class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
          View all {articles.length}
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topArts.map(a => {
          const rt = Math.max(1, Math.ceil(a.data.description.length / 120));
          return (
          <ArticleCard title={a.data.title} description={a.data.description} slug={a.id}
            date={a.data.pubDate} category={a.data.category} readTime={rt + ' min read'} />
        )})}
      </div>
      <div class="mt-8 text-center sm:hidden">
        <a href="/articles" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700">
          View all {articles.length} articles
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ Newsletter ═══ -->
  <section class="py-20 sm:py-24 bg-gradient-to-br from-brand-600 via-brand-700 to-brand-800 relative overflow-hidden">
    <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(circle, white 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="relative mx-auto max-w-xl px-4 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-white/20 px-3.5 py-1 text-xs font-semibold text-white/90 mb-6 uppercase tracking-wider">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        Newsletter
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Stay in the Loop</h2>
      <p class="mt-3 text-brand-200/90 text-lg leading-relaxed">Get our latest comparisons and buying guides delivered to your inbox. No spam, ever.</p>
      <form class="mt-8 flex flex-col sm:flex-row gap-3 justify-center" action="https://buttondown.email/api/emails/embed-subscribe/comparevue" method="POST" target="_blank">
        <input type="email" name="email" required placeholder="you@example.com" class="rounded-xl border-0 px-5 py-4 text-gray-900 sm:min-w-[280px] text-base placeholder:text-gray-400 shadow-lg" />
        <button type="submit" class="rounded-xl bg-white px-8 py-4 font-bold text-brand-700 hover:bg-brand-50 transition shadow-lg shadow-black/10 text-base">
          Subscribe
        </button>
      </form>
      <p class="mt-4 text-sm text-brand-300/80">Unsubscribe anytime. We respect your inbox.</p>
    </div>
  </section>

  <!-- ═══ Bottom CTA ═══ -->
  <section class="py-16 sm:py-20 text-center">
    <div class="mx-auto max-w-xl px-4">
      <h2 class="text-2xl font-extrabold text-gray-900">Don't see the comparison you need?</h2>
      <p class="mt-3 text-gray-500 text-lg">We add new comparisons every month. <a href="/contact" class="text-brand-600 hover:text-brand-700 font-semibold hover:underline">Suggest one →</a></p>
    </div>
  </section>
</BaseLayout>
