---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const articles = await getCollection('articles');

const topComps = comparisons.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 6);
const topArts = articles.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 6);

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CompareVue',
  url: 'https://comparevue.com',
  description: 'Honest, data-driven SaaS and software comparisons to help you pick the right tools.',
};
---

<BaseLayout
  title="CompareVue — Smart SaaS Comparisons"
  description="CompareVue helps you pick the right software with data-driven comparisons and in-depth guides. No fluff — just honest analysis backed by real testing."
  schema={siteSchema}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white py-20 sm:py-28">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <span class="inline-block rounded-full bg-brand-100 text-brand-700 text-sm font-medium px-4 py-1.5 mb-6">
        Updated for 2026 · {comparisons.length} comparisons
      </span>
      <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl lg:text-6xl">
        Find the Right Software<br />
        <span class="text-brand-600">Without the Guesswork</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
        Honest, data-driven comparisons between the top SaaS tools. We test the features, compare the pricing, and help you decide — fast.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/comparisons" class="btn-primary text-lg px-8 py-4">Compare Tools →</a>
        <a href="/articles" class="rounded-lg border border-gray-300 px-8 py-4 text-lg font-semibold text-gray-700 transition hover:bg-gray-50">Read Guides</a>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-y border-gray-100 bg-white py-12">
    <div class="mx-auto max-w-4xl px-4 grid grid-cols-3 gap-8 text-center">
      <div>
        <div class="text-3xl font-extrabold text-brand-600">{comparisons.length}</div>
        <div class="mt-1 text-sm text-gray-500">Comparisons</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand-600">{articles.length}</div>
        <div class="mt-1 text-sm text-gray-500">In-Depth Guides</div>
      </div>
      <div>
        <div class="text-3xl font-extrabold text-brand-600">Monthly</div>
        <div class="mt-1 text-sm text-gray-500">Updated & Fact-Checked</div>
      </div>
    </div>
  </section>

  <!-- Comparisons -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Head-to-Head Comparisons</h2>
          <p class="mt-2 text-gray-600">See how the top tools stack up side by side.</p>
        </div>
        <a href="/comparisons" class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all {comparisons.length} →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topComps.map(c => (
          <ArticleCard title={c.data.title} description={c.data.description}
            slug={'/comparisons/' + c.id} date={c.data.pubDate} category={c.data.category} />
        ))}
      </div>
    </div>
  </section>

  <!-- Articles -->
  <section class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-8">
        <div>
          <h2 class="text-2xl font-bold text-gray-900">Latest Guides & Best-Of Lists</h2>
          <p class="mt-2 text-gray-600">In-depth buying guides researched and written for real users.</p>
        </div>
        <a href="/articles" class="text-sm font-semibold text-brand-600 hover:text-brand-700">View all {articles.length} →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topArts.map(a => (
          <ArticleCard title={a.data.title} description={a.data.description} slug={a.id}
            date={a.data.pubDate} category={a.data.category} />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="bg-brand-600 py-16">
    <div class="mx-auto max-w-2xl px-4 text-center">
      <h2 class="text-2xl font-bold text-white">Stay in the Loop</h2>
      <p class="mt-3 text-brand-100">Get our latest comparisons and buying guides delivered to your inbox.</p>
      <form class="mt-6 flex flex-col sm:flex-row gap-3 justify-center" action="https://buttondown.email/api/emails/embed-subscribe/comparevue" method="POST" target="_blank">
        <input type="email" name="email" required placeholder="you@example.com" class="rounded-lg border-0 px-4 py-3 text-gray-900 sm:max-w-xs w-full" />
        <button type="submit" class="rounded-lg bg-white px-6 py-3 font-semibold text-brand-600 hover:bg-brand-50 transition">Subscribe</button>
      </form>
      <p class="mt-4 text-xs text-brand-200">No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="py-16 text-center">
    <div class="mx-auto max-w-2xl px-4">
      <h2 class="text-2xl font-bold text-gray-900">Don't see the comparison you need?</h2>
      <p class="mt-2 text-gray-600">We add new comparisons every month. <a href="/contact" class="text-brand-600 hover:text-brand-700 font-medium">Suggest one →</a></p>
    </div>
  </section>
</BaseLayout>
