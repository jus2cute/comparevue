---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Terms of Service" description="CompareVue terms of service — rules and guidelines for using our website.">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-extrabold text-gray-900">Terms of Service</h1>
    <p class="mt-2 text-sm text-gray-500">Last updated: June 10, 2026</p>
    <div class="prose prose-lg prose-gray mt-8 max-w-none">
      <h2>Acceptance of Terms</h2>
      <p>By accessing comparevue.com, you agree to be bound by these Terms of Service.</p>
      <h2>Description of Service</h2>
      <p>CompareVue publishes articles, reviews, and buying guides about SaaS tools and software products. Our content is for informational and educational purposes only.</p>
      <h2>Affiliate Disclosure</h2>
      <p>Some links on the Site are affiliate links. We may earn a commission if you click and make a purchase, at no additional cost to you. Our editorial content is not influenced by affiliate partnerships.</p>
      <h2>Limitation of Liability</h2>
      <p>CompareVue shall not be liable for any indirect, incidental, or consequential damages arising out of your use of the Site.</p>
      <h2>Contact</h2>
      <p>Questions? Reach us at <strong>hello@comparevue.com</strong> or visit our <a href="/contact">Contact page</a>.</p>
    </div>
  </section>
</BaseLayout>
